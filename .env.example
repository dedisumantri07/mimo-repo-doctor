# GitHub API
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scope: public_repo (read-only)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Groq API (Primary AI Provider)
# Get your API key from: https://console.groq.com
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ANALYTICS_ID=UA-XXXXXXXXX-X

# Cache Configuration
CACHE_TTL=86400000  # 24 hours in milliseconds
MAX_REPO_SIZE=50000 # Max characters for repository analysis

# Development
NODE_ENV=development
DEBUG=true

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production
SESSION_SECRET=your_session_secret_here_change_in_production

# Rate Limiting
RATE_LIMIT_WINDOW=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window

# Database (Future - Phase 2)
# DATABASE_URL=postgresql://user:password@localhost:5432/mimo_repo_doctor
# REDIS_URL=redis://localhost:6379
